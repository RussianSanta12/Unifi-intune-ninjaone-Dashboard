# UniFi and Intune are out of scope for now — see PLAN.md.

# --- NinjaOne ---
# Use the URL that matches YOUR region (check the address bar when logged
# into the NinjaOne dashboard):
#   US:  https://app.ninjarmm.com     US2: https://us2.ninjarmm.com
#   EU:  https://eu.ninjarmm.com      CA:  https://ca.ninjarmm.com
#   OC:  https://oc.ninjarmm.com
NINJAONE_INSTANCE_URL=https://app.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
# API app setup: platform "API Services (machine-to-machine)", scope
# Monitoring only, grant type Client credentials only (no redirect URI).

# --- Dashboard: department, titles and ticket panels ---
# Each department runs its own copy with its own .env. These are the IT/AV
# values; a Maintenance example is at the end of this section. Board and
# field names must match NinjaOne exactly — run `npm run discover` (from
# backend/) to print the real names. An optional field left empty (FIELD=)
# isn't shown. See backend/lib/panels.js.
DASHBOARD_TITLE=Tickets Dashboard

# Left panel: a list of requests.
LIST_PANEL_TITLE=IT Support Requests
LIST_PANEL_BOARD=IT Support Requests
LIST_PANEL_LOCATION_FIELD=Location(IT)
# Optional DATE field shown as "Needed by ..." under the location.
LIST_PANEL_DATE_FIELD=
# yes: when the list is longer than the panel it scrolls on its own.
# no: it stays still (rows that don't fit can be scrolled with the mouse).
LIST_PANEL_SCROLL=yes

# Right panel: event requests on a month calendar, with the "This Week"
# strip above it. The date field must be a column on the board.
CALENDAR_PANEL_TITLE=AV Support Requests
WEEK_PANEL_TITLE=AV Events This Week
CALENDAR_PANEL_BOARD=AV Support Requests
CALENDAR_PANEL_DATE_FIELD=Date of Event / Program
# Times are free text, shown as typed.
CALENDAR_PANEL_START_TIME_FIELD=Event Start Time
CALENDAR_PANEL_END_TIME_FIELD=End Time
CALENDAR_PANEL_LOCATION_FIELD=Location(IT)
# Recurring events: when the checkbox is ticked, the ticket also shows on
# every day listed in the days field, written month:day, e.g. "11:4, 11:16, 12:13".
CALENDAR_PANEL_RECURRING_FIELD=Reoccurring Event
CALENDAR_PANEL_RECURRING_DAYS_FIELD=Reoccurring Days
# Optional field shown as "👥 N" on the week cards.
CALENDAR_PANEL_ATTENDEES_FIELD=
# Tickets in this status still show (brown) on their event day. The list
# panel never shows them.
CALENDAR_PANEL_CLOSED_STATUS=Closed

# Only tickets in these statuses are shown, sorted in this order. The
# frontend colors them blue / gold / green by position.
NINJAONE_TICKET_STATUSES=New,In Progress,Added to Calendar

# Maintenance department example (its own copy, own .env; also set
# CALENDAR_SYNC_ENABLED=false below and use its own NinjaOne API app):
#   LIST_PANEL_TITLE=Maintenance Requests
#   LIST_PANEL_BOARD=Maintenance Requests
#   LIST_PANEL_LOCATION_FIELD=Location (maintenance)
#   LIST_PANEL_DATE_FIELD=Date Service Needed by:
#   CALENDAR_PANEL_TITLE=Event Maintenance Requests
#   WEEK_PANEL_TITLE=Maintenance Events This Week
#   CALENDAR_PANEL_BOARD=Event Maintenance Requests
#   CALENDAR_PANEL_LOCATION_FIELD=Location (maintenance)
#   CALENDAR_PANEL_RECURRING_FIELD=
#   CALENDAR_PANEL_RECURRING_DAYS_FIELD=
#   CALENDAR_PANEL_ATTENDEES_FIELD=Estimated Number of Attendees
#
# Older names still work when the new ones aren't set: NINJAONE_IT_BOARD,
# NINJAONE_IT_LOCATION_FIELD, NINJAONE_AV_BOARD, NINJAONE_AV_EVENT_DATE_FIELD,
# NINJAONE_AV_START_TIME_FIELD, NINJAONE_AV_END_TIME_FIELD,
# NINJAONE_AV_LOCATION_FIELD, NINJAONE_AV_RECURRING_FIELD,
# NINJAONE_AV_RECURRING_DAYS_FIELD, NINJAONE_AV_CLOSED_STATUS.

# --- Calendar sync (AV tickets → events calendar) ---
# Each poll, AV tickets are checked for what the calendar needs and get a
# private "[Calendar check]" note: approved, or a missing-info form. See connectors/calendarSync.js.
# Turns the whole feature on: the check/approve/add cycle, the dashboard's
# alert banner and the "needs info" marker. Anything but true = off (not
# polled, nothing shown).
CALENDAR_SYNC_ENABLED=false
# Dry run (default) only logs what it would do and needs no extra credentials.
# Set to false once the two apps below are set up and the log looks right.
CALENDAR_SYNC_DRY_RUN=true
# Testing: only these ticket IDs are checked/added (comma-separated; empty = all).
# Or run one pass by hand: npm run sync-once -- --live 1234
CALENDAR_SYNC_ONLY_TICKETS=
CALENDAR_MAILBOX=events-calendar@example.org
# For npm run check-connections: any other mailbox, which the calendar app
# must be refused (e.g. your own).
CALENDAR_CHECK_OTHER_MAILBOX=
CALENDAR_TIME_ZONE=America/New_York
# Board and field names come from CALENDAR_PANEL_* above (AV only).
# AV tickets in these statuses are checked; approved ones go on the
# calendar once staff set them to CALENDAR_SYNC_ADD_STATUS.
CALENDAR_SYNC_CHECK_STATUSES=New,In Progress
CALENDAR_SYNC_ADD_STATUS=Added to Calendar
# Assigned when a ticket is approved: NinjaOne technician IDs by the main
# event date's weekday (npm run discover lists users via /v2/user/technicians).
CALENDAR_SYNC_ASSIGNEE_MON_WED=2
CALENDAR_SYNC_ASSIGNEE_THU_SUN=5

# Microsoft Graph app for the calendar: Application permission
# Calendars.ReadWrite + admin consent, limited to CALENDAR_MAILBOX in
# Exchange Online. Separate from the Intune app.
CALENDAR_TENANT_ID=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=

# NinjaOne "Web" app for ticket writes (client-credentials apps can't update
# tickets). Scopes Monitoring + Management + Offline access; grant types
# Authorization code + Refresh token; redirect URI below. After filling these
# in, open http://localhost:3000/auth/ninjaone/start on the server and sign in.
NINJAONE_WEB_CLIENT_ID=
NINJAONE_WEB_CLIENT_SECRET=
NINJAONE_WEB_REDIRECT_URI=http://localhost:3000/auth/ninjaone/callback

# --- App config ---
PORT=3000
REFRESH_INTERVAL_SECONDS=60
