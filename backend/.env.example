# --- UniFi (Site Manager API — Ubiquiti cloud, api.ui.com) ---
# Generate this key at unifi.ui.com (your Ubiquiti cloud/SSO account).
# No host/username/password needed — auth is just this one key.
UNIFI_API_KEY=
# Optional: if your account has multiple sites/workspaces, set this to the
# workspace name you want treated as "home" for the monthly unique-client
# tracking. Leave blank to just use whichever workspace comes first.
UNIFI_SITE=

# NOTE: Site Manager calls Ubiquiti's cloud, not your controller directly —
# requires your gateway to be linked to a Ubiquiti cloud account and
# outbound internet access from this server. For a fully local/offline
# setup instead, use local controller auth (session cookie against your
# controller's own IP, or a local API key once migrated to UniFi OS).

# --- NinjaOne ---
# Use the URL that matches YOUR region (check the address bar when logged
# into the NinjaOne dashboard):
#   US:  https://app.ninjarmm.com     US2: https://us2.ninjarmm.com
#   EU:  https://eu.ninjarmm.com      CA:  https://ca.ninjarmm.com
#   OC:  https://oc.ninjarmm.com
NINJAONE_INSTANCE_URL=https://app.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=

# --- Intune / Microsoft Graph ---
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# --- App config ---
PORT=3000
REFRESH_INTERVAL_SECONDS=60
