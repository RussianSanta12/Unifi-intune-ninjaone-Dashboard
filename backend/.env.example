# UniFi and Intune are out of scope for now — see PLAN.md.

# --- NinjaOne ---
# Use the URL that matches YOUR region (check the address bar when logged
# into the NinjaOne dashboard):
#   US:  https://app.ninjarmm.com     US2: https://us2.ninjarmm.com
#   EU:  https://eu.ninjarmm.com      CA:  https://ca.ninjarmm.com
#   OC:  https://oc.ninjarmm.com
NINJAONE_INSTANCE_URL=https://app.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=
# API app setup: platform "API Services (machine-to-machine)", scope
# Monitoring only, grant type Client credentials only (no redirect URI).

# --- NinjaOne ticketing (IT / AV support request panels) ---
# Names must match NinjaOne exactly. Run `npm run discover` (from backend/)
# to print the real board, field, and status names. These are the defaults.
NINJAONE_IT_BOARD=IT Support Requests
NINJAONE_AV_BOARD=AV Support Requests
NINJAONE_AV_EVENT_DATE_FIELD=Date of Event / Program
# Only tickets in these statuses are shown, sorted in this order. The
# frontend colors them blue / gold / green by position.
NINJAONE_TICKET_STATUSES=New,In Progress,Added to Calendar

# --- Calendar sync (AV tickets → events calendar) ---
# Each poll, AV tickets in CALENDAR_SYNC_FROM_STATUS are put on the shared
# calendar and moved to CALENDAR_SYNC_TO_STATUS. See connectors/calendarSync.js.
# Dry run (default) only logs what it would do and needs no extra credentials.
# Set to false once the two apps below are set up and the log looks right.
CALENDAR_SYNC_DRY_RUN=true
CALENDAR_MAILBOX=events-calendar@example.org
CALENDAR_TIME_ZONE=America/New_York
NINJAONE_AV_START_TIME_FIELD=Event Start Time
NINJAONE_AV_END_TIME_FIELD=End Time
NINJAONE_AV_LOCATION_FIELD=Location(IT)
CALENDAR_SYNC_FROM_STATUS=New
CALENDAR_SYNC_TO_STATUS=Added to Calendar
# NinjaOne technician IDs, by the event's weekday (npm run discover lists users
# via /v2/user/technicians).
CALENDAR_SYNC_ASSIGNEE_MON_WED=2
CALENDAR_SYNC_ASSIGNEE_THU_SUN=5
# Tickets with unreadable event times are retried this often.
CALENDAR_SYNC_RETRY_HOURS=24

# Microsoft Graph app for the calendar: Application permission
# Calendars.ReadWrite + admin consent, limited to CALENDAR_MAILBOX in
# Exchange Online. Separate from the Intune app.
CALENDAR_TENANT_ID=
CALENDAR_CLIENT_ID=
CALENDAR_CLIENT_SECRET=

# NinjaOne "Web" app for ticket writes (client-credentials apps can't update
# tickets). Scopes Monitoring + Management + Offline access; grant types
# Authorization code + Refresh token; redirect URI below. After filling these
# in, open http://localhost:3000/auth/ninjaone/start on the server and sign in.
NINJAONE_WEB_CLIENT_ID=
NINJAONE_WEB_CLIENT_SECRET=
NINJAONE_WEB_REDIRECT_URI=http://localhost:3000/auth/ninjaone/callback

# --- App config ---
PORT=3000
REFRESH_INTERVAL_SECONDS=60
