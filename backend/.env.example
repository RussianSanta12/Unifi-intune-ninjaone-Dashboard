# --- UniFi (self-hosted Network Application) ---
UNIFI_HOST=https://192.168.1.1:8443
UNIFI_USERNAME=dashboard-local-admin
UNIFI_PASSWORD=
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false
# When migrating to UniFi OS, remove the four lines above and use instead:
# UNIFI_API_KEY=
# UNIFI_HOST=https://<console-ip-or-hostname>

# --- NinjaOne ---
NINJAONE_INSTANCE_URL=https://app.ninjarmm.com
NINJAONE_CLIENT_ID=
NINJAONE_CLIENT_SECRET=

# --- Intune / Microsoft Graph ---
INTUNE_TENANT_ID=
INTUNE_CLIENT_ID=
INTUNE_CLIENT_SECRET=

# --- App config ---
PORT=3000
REFRESH_INTERVAL_SECONDS=60
