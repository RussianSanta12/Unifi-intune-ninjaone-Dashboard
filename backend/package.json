{
  "name": "stats-dashboard-backend",
  "version": "1.0.0",
  "description": "Local backend that polls NinjaOne (devices + ticketing) and serves aggregated stats to the dashboard frontend.",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file=.env server.js",
    "dev": "node --env-file=.env --watch server.js",
    "discover": "node --env-file=.env scripts/discover.js",
    "check-calendar": "node scripts/check-calendar.js",
    "check-connections": "node --env-file=.env scripts/check-connections.js",
    "sync-once": "node --env-file=.env scripts/sync-once.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
